---
// PROTOTYPE variant A: big hero, then a bento grid of mini home pages. Flagships get the wide slots.
import type { GitHubStats } from '../../projects'
import { projects } from '../../projects'
import MiniHero from '../MiniHero.astro'

type Props = { stats: Map<string, GitHubStats>; totalStars: number }
const { stats, totalStars } = Astro.props

const span = (skin: string) => (skin === 'glow' || skin === 'dots' ? 'wide' : skin === 'readme' ? 'small' : 'mid')
---

<section class="hero">
  <h1><span class="brand">falconDev</span> builds type-safe libraries and self-hosted tools.</h1>
  <div class="hero-side">
    <p class="lede">
      Outstanding type-safety and developer experience without compromise. {projects.length} projects{
        totalStars > 0 && `, ${totalStars.toLocaleString('en-US')} stars`
      }, all MIT licensed.
    </p>
    <div class="actions">
      <a class="button primary" href="https://github.com/falcondev-oss">GitHub</a>
      <a class="button" href="https://github.com/sponsors/falcondev-oss">Sponsor</a>
    </div>
  </div>
</section>

<ul class="bento">
  {
    projects.map((p) => (
      <li class={span(p.skin)}>
        <MiniHero project={p} stars={stats.get(p.repo)?.stars} />
      </li>
    ))
  }
</ul>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: clamp(2.5rem, 7vw, 5rem) 0 clamp(3rem, 6vw, 4.5rem);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -12rem -50vw -4rem;
    z-index: -1;
    background: radial-gradient(
      40rem 22rem at 75% 20%,
      color-mix(in oklch, var(--sl-color-accent) 16%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.04;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .brand {
    background: var(--fd-gradient);
    background-clip: text;
    color: transparent;
  }
  .hero-side {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 4rem;
    align-items: end;
  }
  .lede {
    max-width: 36rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .actions {
    display: flex;
    gap: 0.75rem;
  }
  .button {
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    font-weight: 500;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .button:hover {
    border-color: var(--sl-color-gray-3);
  }
  .button.primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: white;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bento li {
    margin: 0;
  }
  .wide {
    grid-column: span 3;
    min-height: 26rem;
  }
  .mid {
    grid-column: span 2;
    min-height: 17rem;
  }
  .small {
    grid-column: span 2;
  }

  @media (max-width: 64rem) {
    .hero-side {
      grid-template-columns: minmax(0, 1fr);
    }
    .bento > li {
      grid-column: span 3;
    }
  }
  @media (max-width: 40rem) {
    .bento > li {
      grid-column: span 6;
      min-height: 0;
    }
  }
</style>
