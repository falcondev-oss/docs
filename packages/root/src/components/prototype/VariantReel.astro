---
// PROTOTYPE variant C: scroll through full-size home pages, one per project, with a sticky rail that tracks the current one.
import type { GitHubStats } from '../../projects'
import { groups, projects } from '../../projects'
import MiniHero from '../MiniHero.astro'

type Props = { stats: Map<string, GitHubStats>; totalStars: number }
const { stats, totalStars } = Astro.props
const ordered = groups.flatMap((group) => projects.filter((p) => p.group === group))
---

<div class="reel">
  <nav class="rail">
    <a class="rail-brand" href="#reel-top">falconDev</a>
    {
      groups.map((group) => (
        <div>
          <p>{group}</p>
          {projects
            .filter((p) => p.group === group)
            .map((p) => (
              <a href={`#reel-${p.repo}`} data-rail={p.repo}>
                {p.name}
              </a>
            ))}
        </div>
      ))
    }
  </nav>

  <div class="frames">
    <section id="reel-top" class="intro">
      <h1>
        Open source by <span class="brand">falconDev</span>.
      </h1>
      <p>
        Type-safe libraries and self-hosted tools. {projects.length} projects{
          totalStars > 0 && `, ${totalStars.toLocaleString('en-US')} stars on GitHub`
        }. Scroll through their home pages.
      </p>
    </section>
    {
      ordered.map((p, i) => (
        <section id={`reel-${p.repo}`} data-frame={p.repo}>
          <div class="caption">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <span>{p.group}</span>
            <a href={p.url}>{p.url.replace('https://', '')} ↗</a>
          </div>
          <div class="frame">
            <MiniHero project={p} stars={stats.get(p.repo)?.stars} />
          </div>
        </section>
      ))
    }
  </div>
</div>

<script>
  const links = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-rail]')].map((a) => [a.dataset.rail!, a]),
  )
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        for (const a of links.values()) a.classList.remove('current')
        links.get((entry.target as HTMLElement).dataset.frame!)?.classList.add('current')
      }
    },
    { rootMargin: '-45% 0px -45% 0px' },
  )
  for (const frame of document.querySelectorAll('[data-frame]')) observer.observe(frame)
</script>

<style>
  .reel {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 3rem;
    margin-top: 2rem;
  }
  .rail {
    position: sticky;
    top: calc(var(--sl-nav-height) + 2rem);
    align-self: start;
    display: grid;
    gap: 1.25rem;
    font-size: var(--sl-text-sm);
  }
  .rail-brand {
    font-weight: 600;
    background: var(--fd-gradient);
    background-clip: text;
    color: transparent;
    text-decoration: none;
  }
  .rail p {
    margin: 0 0 0.35rem;
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .rail a[data-rail] {
    display: block;
    padding: 0.2rem 0 0.2rem 0.75rem;
    border-left: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .rail a[data-rail]:hover {
    color: var(--sl-color-white);
  }
  .rail a:global(.current) {
    border-left-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .frames {
    display: grid;
    gap: 5rem;
  }
  section {
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }
  .intro {
    min-height: 50vh;
    display: grid;
    align-content: center;
    gap: 1.5rem;
  }
  .intro h1 {
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--sl-color-white);
  }
  .brand {
    background: var(--fd-gradient);
    background-clip: text;
    color: transparent;
  }
  .intro p {
    max-width: 34rem;
    font-size: var(--sl-text-xl);
    color: var(--sl-color-gray-2);
  }
  .caption {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font: var(--sl-text-xs) var(--sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .caption a {
    margin-left: auto;
    color: var(--sl-color-accent-high);
    text-decoration: none;
  }
  .frame {
    height: min(68vh, 40rem);
    box-shadow: 0 30px 80px -40px rgb(0 0 0 / 0.6);
    border-radius: 0.6rem;
  }

  @media (max-width: 56rem) {
    .reel {
      grid-template-columns: minmax(0, 1fr);
    }
    .rail {
      display: none;
    }
    .frame {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
