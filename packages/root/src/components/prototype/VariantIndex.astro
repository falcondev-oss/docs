---
// PROTOTYPE variant B: a dense index of every project with a sticky live preview of the hovered one.
import type { GitHubStats } from '../../projects'
import { groups, projects } from '../../projects'
import MiniHero from '../MiniHero.astro'

type Props = { stats: Map<string, GitHubStats>; totalStars: number }
const { stats, totalStars } = Astro.props

const thisYear = new Date().getFullYear()
const formatDate = (date: Date) =>
  date.toLocaleDateString(
    'en-US',
    date.getFullYear() === thisYear ? { month: 'short', day: 'numeric' } : { month: 'short', year: 'numeric' },
  )
---

<header class="head">
  <div>
    <h1><span class="brand">falconDev</span> OSS</h1>
    <p>Type-safe libraries and self-hosted tools. MIT licensed.</p>
  </div>
  <dl>
    <div><dt>Projects</dt><dd>{projects.length}</dd></div>
    {totalStars > 0 && <div><dt>Stars</dt><dd>{totalStars.toLocaleString('en-US')}</dd></div>}
    <div><dt>Links</dt><dd><a href="https://github.com/falcondev-oss">GitHub</a> <a href="https://github.com/sponsors/falcondev-oss">Sponsor</a></dd></div>
  </dl>
</header>

<div class="index">
  <table>
    <colgroup>
      <col style="width: 14rem" />
      <col />
      <col style="width: 3.5rem" />
      <col style="width: 6rem" />
    </colgroup>
    {
      groups.map((group) => (
        <tbody>
          <tr class="group">
            <th colspan="4">{group}</th>
          </tr>
          {projects
            .filter((p) => p.group === group)
            .map((p) => {
              const s = stats.get(p.repo)
              return (
                <tr data-preview={p.repo} tabindex="0">
                  <th scope="row">
                    <a href={p.url}>
                      {p.logo ? <img src={p.logo} alt="" /> : <span class="no-logo" />}
                      {p.name}
                    </a>
                  </th>
                  <td class="summary">{p.summary}</td>
                  <td class="num">{s && `★ ${s.stars}`}</td>
                  <td class="num">{s && formatDate(s.pushedAt)}</td>
                </tr>
              )
            })}
        </tbody>
      ))
    }
  </table>

  <aside class="preview">
    {
      projects.map((p, i) => (
        <div data-preview-of={p.repo} hidden={i > 0}>
          <MiniHero project={p} stars={stats.get(p.repo)?.stars} />
          <code class="cmd">{p.command}</code>
        </div>
      ))
    }
  </aside>
</div>

<script>
  const panes = document.querySelectorAll<HTMLElement>('[data-preview-of]')
  for (const row of document.querySelectorAll<HTMLElement>('[data-preview]')) {
    const show = () => {
      for (const pane of panes) pane.hidden = pane.dataset.previewOf !== row.dataset.preview
      for (const other of document.querySelectorAll('[data-preview].active')) other.classList.remove('active')
      row.classList.add('active')
    }
    row.addEventListener('mouseenter', show)
    row.addEventListener('focus', show)
    row.addEventListener('click', (event) => {
      if (!(event.target as HTMLElement).closest('a')) row.querySelector('a')?.click()
    })
  }
  document.querySelector<HTMLElement>('[data-preview]')?.dispatchEvent(new Event('mouseenter'))
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 3rem;
    margin: 3rem 0 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--sl-color-white);
  }
  .brand {
    background: var(--fd-gradient);
    background-clip: text;
    color: transparent;
  }
  .head p {
    margin-top: 0.25rem;
    color: var(--sl-color-gray-3);
  }
  dl {
    display: flex;
    gap: 2.5rem;
    margin: 0;
  }
  dt {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  dd {
    margin: 0.2rem 0 0;
    font: 500 var(--sl-text-lg) var(--sl-font-mono);
    color: var(--sl-color-white);
  }
  dd a {
    font: 500 var(--sl-text-base) var(--sl-font);
    color: var(--sl-color-accent-high);
    text-decoration: none;
    margin-right: 0.75rem;
  }

  .index {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }
  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  .group th {
    padding: 1.5rem 0 0.4rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: left;
  }
  tbody:first-child .group th {
    padding-top: 0;
  }
  tr[data-preview] {
    cursor: pointer;
    outline: none;
  }
  tr[data-preview] :is(th, td) {
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-top: 1px solid var(--sl-color-hairline);
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: none;
    letter-spacing: normal;
    font-size: var(--sl-text-sm);
  }
  tr[data-preview] th a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 500;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  tr[data-preview] img,
  .no-logo {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  .no-logo {
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.25rem;
  }
  .summary {
    color: var(--sl-color-gray-3);
  }
  .num {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs) !important;
    color: var(--sl-color-gray-3);
    text-align: right !important;
  }
  tr:global(.active) :is(th, td) {
    background: var(--sl-color-accent-low);
  }
  tr:global(.active) .summary {
    color: var(--sl-color-gray-1);
  }

  .preview {
    position: sticky;
    top: calc(var(--sl-nav-height) + 1.5rem);
  }
  .preview > div:not([hidden]) {
    display: grid;
    gap: 0.75rem;
  }
  .preview :global(.mini) {
    aspect-ratio: 16 / 11;
  }
  .cmd {
    font: var(--sl-text-xs) var(--sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .cmd::before {
    content: '$ ';
    color: var(--sl-color-accent-high);
  }

  @media (max-width: 64rem) {
    .index {
      grid-template-columns: minmax(0, 1fr);
    }
    .preview {
      display: none;
    }
  }
</style>
