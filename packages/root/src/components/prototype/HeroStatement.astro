---
// PROTOTYPE hero 1: one long statement as the title, description and buttons on one row below.
type Props = { projectCount: number; totalStars: number }
const { projectCount, totalStars } = Astro.props
---

<section class="hero">
  <h1><span class="fd-brand">falconDev</span> builds type-safe libraries and self-hosted tools.</h1>
  <div class="side">
    <p>
      Outstanding type safety and developer experience without compromise. {projectCount} projects{
        totalStars > 0 && `, ${totalStars.toLocaleString('en-US')} stars`
      }, all MIT licensed.
    </p>
    <div class="fd-actions">
      <a class="fd-button primary" href="https://github.com/falcondev-oss">GitHub</a>
      <a class="fd-button" href="https://github.com/sponsors/falcondev-oss">Sponsor</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: 2rem;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -12rem -50vw -4rem;
    z-index: -1;
    background: radial-gradient(
      40rem 22rem at 75% 20%,
      color-mix(in oklch, var(--sl-color-accent) 16%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.04;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .side {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 4rem;
    align-items: end;
  }
  p {
    max-width: 36rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  @media (max-width: 64rem) {
    .side {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
