---
/**
 * lang.falcondev.io in small: violet on graphite with the dither background, a headline that
 * decodes through other languages, and busy words that switch languages the same way.
 * Texts are copied from the lang docs, which write them with lang itself.
 */
import type { Project } from '../../projects'

type Props = { project: Project }
const { project } = Astro.props

const headlines = {
  en: 'Every string in your app, translated and type-checked.',
  ja: 'アプリのすべての文字列を、翻訳して型チェック。',
  es: 'Cada texto de tu app, traducido y con tipos.',
  de: 'Jeder Text deiner App, übersetzt und typgeprüft.',
}
// [en, de, es, ja, pl]
const words = [
  ['Pondering…', 'Grübeln…', 'Reflexionando…', '思案中…', 'Rozmyślanie…'],
  ['Percolating…', 'Aufbrühen…', 'Filtrando…', '抽出中…', 'Parzenie…'],
  ['Simmering…', 'Köcheln…', 'A fuego lento…', '煮込み中…', 'Pyrkanie…'],
  ['Reticulating splines…', 'Splines retikulieren…', 'Reticulando splines…', 'スプラインを網状化中…', 'Siatkowanie splajnów…'],
  ['Conjuring…', 'Herbeizaubern…', 'Conjurando…', '召喚中…', 'Wyczarowywanie…'],
  ['Vibing…', 'Viben…', 'Fluyendo…', 'ノリノリ中…', 'Wajbowanie…'],
  ['Finagling…', 'Hinbiegen…', 'Apañando…', 'やりくり中…', 'Kombinowanie…'],
]
const install = 'pnpm add @falcondev-oss/lang-core'
---

<a class="card" href={project.url} data-lang-card={JSON.stringify({ headlines, words })}>
  <canvas class="dither" aria-hidden="true"></canvas>
  <div class="nav">
    {project.logo && <img src={project.logo} alt="" />}
    <span>{project.name}</span>
  </div>

  <h3 lang="en">{headlines.en}</h3>
  <p class="lede">
    Wrap the text you already wrote in <code>t()</code> and add the other languages right there. The English stays the
    key, TypeScript checks the rest.
  </p>

  <div class="words" aria-hidden="true">
    <span class="w" style="--x: 4%; --y: 6%"><b>✻</b><span></span><i></i></span>
    <span class="w" style="--x: 38%; --y: 40%"><b>✻</b><span></span><i></i></span>
    <span class="w" style="--x: 12%; --y: 74%"><b>✻</b><span></span><i></i></span>
  </div>

  <div class="actions">
    <span class="button primary">Get started</span>
    <span class="install"><b>$</b>{install}</span>
  </div>
</a>

<script>
  import { decode } from './decode'
  import { initDither } from './dither'

  const LANGS = ['en', 'de', 'es', 'ja', 'pl'] as const
  const SPIN = ['·', '✢', '✳', '✶', '✻', '✽', '✻', '✶', '✳', '✢']
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches

  for (const card of document.querySelectorAll<HTMLElement>('[data-lang-card]')) {
    const { headlines, words } = JSON.parse(card.dataset.langCard!) as {
      headlines: Record<string, string>
      words: string[][]
    }
    initDither(card.querySelector('canvas')!)

    let visible = false
    new IntersectionObserver(([entry]) => (visible = !!entry?.isIntersecting)).observe(card)
    const whenShown = async () => {
      while (!visible || document.hidden) await sleep(500)
    }

    // the headline arrives through other languages and comes back to English, over and over
    const h3 = card.querySelector('h3')!
    const chips = [...card.querySelectorAll<HTMLElement>('.w')]
    const show = (chip: HTMLElement, word: number, lang: number) => {
      const tag = chip.querySelector('i')!
      const text = chip.querySelector('span')!
      tag.textContent = tag.className = LANGS[lang]!
      text.textContent = words[word]![lang]!
      text.lang = LANGS[lang]!
      decode(text, { spread: 420, dur: 340 })
    }

    if (calm) {
      chips.forEach((chip, n) => (show(chip, n, (n + 1) % LANGS.length), chip.classList.add('in')))
      continue
    }

    void (async () => {
      const order = ['ja', 'es', 'de', 'en']
      for (;;) {
        for (const l of order) {
          await whenShown()
          h3.textContent = headlines[l]!
          h3.lang = l
          decode(h3, { spread: 160, dur: 180 })
          await sleep(l === 'en' ? 5200 : 2200)
        }
      }
    })()

    let frame = 0
    setInterval(() => {
      if (!visible) return
      frame++
      chips.forEach((chip, i) => (chip.querySelector('b')!.textContent = SPIN[(frame + i * 3) % SPIN.length]!))
    }, 130)

    const used = new Set<number>()
    chips.forEach((chip, n) => {
      void (async () => {
        await sleep(600 + n * 1100)
        for (;;) {
          await whenShown()
          let word = Math.floor(Math.random() * words.length)
          while (used.has(word)) word = (word + 1) % words.length
          used.add(word)
          let lang = Math.floor(Math.random() * LANGS.length)
          show(chip, word, lang)
          chip.classList.add('in')
          for (let i = 0; i < 2 + Math.floor(Math.random() * 2); i++) {
            await sleep(2400 + Math.random() * 1400)
            lang = (lang + 1 + Math.floor(Math.random() * (LANGS.length - 1))) % LANGS.length
            show(chip, word, lang)
          }
          await sleep(2600)
          chip.classList.remove('in')
          await sleep(1400 + Math.random() * 2000)
          used.delete(word)
        }
      })()
    })
  }
</script>

<style>
  .card {
    /* the lang docs: violet on graphite */
    --accent: oklch(72% 0.18 300);
    --bg: oklch(15.5% 0.008 295);
    --bg-3: oklch(22% 0.012 295);
    --line: oklch(100% 0 0 / 0.08);
    --line-2: oklch(100% 0 0 / 0.14);
    --tx: oklch(97% 0.005 295);
    --tx-2: oklch(80% 0.012 295);
    --tx-3: oklch(66% 0.014 295);
    --de: oklch(82% 0.13 80);
    --es: oklch(75% 0.15 32);
    --ja: oklch(80% 0.11 195);
    --pl: oklch(76% 0.13 350);
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    height: 100%;
    padding: 0 2rem 2rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: var(--bg);
    color: var(--tx);
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  :global([data-theme='light']) .card {
    --accent: oklch(52% 0.22 300);
    --bg: oklch(99.3% 0.003 295);
    --bg-3: oklch(94% 0.008 295);
    --line: oklch(0% 0 0 / 0.08);
    --line-2: oklch(0% 0 0 / 0.14);
    --tx: oklch(18% 0.01 295);
    --tx-2: oklch(36% 0.012 295);
    --tx-3: oklch(46% 0.014 295);
    --de: oklch(52% 0.13 65);
    --es: oklch(53% 0.18 32);
    --ja: oklch(50% 0.1 210);
    --pl: oklch(52% 0.18 350);
  }
  .card:hover {
    border-color: var(--sl-color-gray-4);
  }
  .dither {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    color: var(--accent);
    opacity: 0.17;
    pointer-events: none;
  }
  :global([data-theme='light']) .dither {
    opacity: 0.13;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-inline: -2rem;
    margin-bottom: 0.75rem;
    padding: 0.7rem 2rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklch, var(--bg) 85%, transparent);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .nav img {
    width: 1.3rem;
    height: 1.3rem;
  }
  h3 {
    min-height: 3.12em;
    margin: 0;
    font-size: clamp(1.6rem, 6.6cqi, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.04;
    color: var(--tx);
    text-wrap: balance;
  }
  h3:lang(ja) {
    letter-spacing: 0;
  }
  .lede {
    margin: 0;
    max-width: 30rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--tx-2);
  }
  .lede code {
    font: 0.9em 'Geist Mono Variable', monospace;
  }

  /* decode: a glyph sits on each character until it resolves */
  .card :global(.sc) {
    position: relative;
    -webkit-text-fill-color: transparent;
  }
  .card :global(.sc::after) {
    content: attr(data-g);
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    overflow: hidden;
    -webkit-text-fill-color: currentColor;
    opacity: 0.4;
    font-family: ui-monospace, monospace;
    font-weight: 400;
    letter-spacing: 0;
  }

  .words {
    position: relative;
    flex: 1;
    min-height: 7.5rem;
  }
  .w {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 60%;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    background: color-mix(in oklch, var(--bg) 80%, transparent);
    backdrop-filter: blur(3px);
    font: 0.78rem/1.2 'Geist Mono Variable', monospace;
    color: var(--tx-2);
    white-space: nowrap;
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 1.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      translate 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .w:global(.in) {
    opacity: 0.85;
    translate: 0 0;
  }
  .w > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .w b {
    flex: none;
    width: 1ch;
    font-weight: 400;
    color: var(--accent);
  }
  .w i {
    flex: none;
    font-style: normal;
    font-size: 0.64rem;
    text-transform: uppercase;
    color: var(--tx-3);
  }
  .w i:global(.de) {
    color: var(--de);
  }
  .w i:global(.es) {
    color: var(--es);
  }
  .w i:global(.ja) {
    color: var(--ja);
  }
  .w i:global(.pl) {
    color: var(--pl);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .button {
    padding: 0.55rem 0.95rem;
    border-radius: 0.45rem;
    background: var(--accent);
    color: white;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .install {
    display: inline-flex;
    align-items: center;
    height: 2.35rem;
    gap: 0.6rem;
    max-width: 100%;
    padding: 0 0.8rem;
    border: 1px dashed var(--line-2);
    border-radius: 0.45rem;
    background: color-mix(in oklch, var(--bg) 80%, transparent);
    font: 0.78rem 'Geist Mono Variable', monospace;
    color: var(--tx-2);
    white-space: nowrap;
    overflow: hidden;
  }
  .install b {
    font-weight: 400;
    color: var(--tx-3);
  }

  @container (max-width: 26rem) {
    .words {
      display: none;
    }
  }
</style>
