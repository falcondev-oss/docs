---
// PROTOTYPE: four hero variants above the project grid, switched with `?variant=1..4` and the bottom bar.
// Once one wins, keep it here and move the rest to the `prototype/starlight-home` branch.
import { fetchStats, projects } from '../projects'
import ProjectGrid from './ProjectGrid.astro'
import HeroCentered from './prototype/HeroCentered.astro'
import HeroPrinciples from './prototype/HeroPrinciples.astro'
import HeroStatement from './prototype/HeroStatement.astro'
import HeroTerminal from './prototype/HeroTerminal.astro'
import PrototypeSwitcher from './prototype/PrototypeSwitcher.astro'

const stats = await fetchStats()
const totalStars = projects.reduce((sum, p) => sum + (stats.get(p.repo)?.stars ?? 0), 0)

const heroes = [
  { key: '1', name: 'Statement', Component: HeroStatement },
  { key: '2', name: 'Centered', Component: HeroCentered },
  { key: '3', name: 'Terminal', Component: HeroTerminal },
  { key: '4', name: 'Principles', Component: HeroPrinciples },
] as const
---

<div class="home not-content">
  <div class="hero-slot">
    {
      heroes.map(({ key, Component }, i) => (
        <div data-variant={key} hidden={i > 0}>
          <Component projectCount={projects.length} totalStars={totalStars} />
        </div>
      ))
    }
  </div>
  <ProjectGrid stats={stats} />
</div>
{import.meta.env.DEV && <PrototypeSwitcher variants={heroes.map(({ key, name }) => ({ key, name }))} />}

<style>
  :global(main:has(.home)) {
    overflow-x: clip;
  }
  :global(main:has(.home) .sl-container) {
    max-width: none;
  }
  :global(main:has(.home) .content-panel) {
    padding-top: 0;
    border: 0;
  }
  .home {
    max-width: 80rem;
    margin-inline: auto;
    padding-bottom: 5rem;
  }
  .hero-slot {
    margin: clamp(2.5rem, 7vw, 5rem) 0 clamp(3rem, 6vw, 4.5rem);
  }
</style>
