{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_API_TOKEN",
    "GITHUB_TOKEN"
  ],
  "concurrency": "15",
  "globalDependencies": ["default-config.ts", "theme/**"],
  "tasks": {
    "deploy": {
      "dependsOn": ["build"],
      "outputs": [".wrangler/**"]
    },
    "build": {
      "outputs": ["dist/**", ".vitepress/cache/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
